<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dual_rm_75b_description">

    <xacro:arg name="arm_model" default="75b"/>
    <!-- ADD THIS LINE SO MOVEIT KNOWS ABOUT THE 4C2 -->
    <xacro:arg name="gripper_type" default="4c2"/>
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml"/>

    <!-- Import robot description -->
    <xacro:include filename="$(find dual_rm_description)/urdf/r2d3_description.urdf.xacro" />

    <!-- Import control xacro -->
    <xacro:include filename="dual_rm_75b_description.ros2_control.xacro" />
    <xacro:dual_rm_75b_description_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>