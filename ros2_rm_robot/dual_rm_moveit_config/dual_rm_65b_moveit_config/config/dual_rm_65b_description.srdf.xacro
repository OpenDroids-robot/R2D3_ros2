        <disable_collisions link1="l_4c2_base_link" link2="link_swivel_wheel_4_2" reason="Never"/>
        <disable_collisions link1="l_4c2_base_link" link2="r_l_2_base" reason="Never"/>
        <disable_collisions link1="l_4c2_base_link" link2="r_r_2_base" reason="Never"/>
        <disable_collisions link1="l_4c2_base_link" link2="r_r_3" reason="Never"/>
        
        <disable_collisions link1="l_l_1" link2="l_l_2" reason="Never"/>
        <disable_collisions link1="l_l_1" link2="l_l_2_base" reason="Never"/>
        <disable_collisions link1="l_l_1" link2="l_l_3" reason="Adjacent"/>
