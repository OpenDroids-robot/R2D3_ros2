<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dual_rm_65b_description">
    
    <!-- DYNAMIC LAUNCH ARGUMENT -->
    <xacro:arg name="gripper_type" default="dummy"/>

    <!-- ==================================================== -->
    <!-- STANDARD GROUPS & STATES (Always Loaded)             -->
    <!-- ==================================================== -->
    <group name="left_arm">
        <chain base_link="l_base_link1" tip_link="l_link6"/>
    </group>
    <group name="right_arm">
        <chain base_link="r_base_link1" tip_link="r_link6"/>
    </group>
    <group name="platform">
        <chain base_link="body_base_link" tip_link="platform_base_link"/>
    </group>
    <group_state name="home" group="left_arm">
        <joint name="l_joint1" value="0"/>
        <joint name="l_joint2" value="0"/>
        <joint name="l_joint3" value="0"/>
        <joint name="l_joint4" value="0"/>
        <joint name="l_joint5" value="0"/>
        <joint name="l_joint6" value="0"/>
    </group_state>
    <group_state name="home" group="right_arm">
        <joint name="r_joint1" value="0"/>
        <joint name="r_joint2" value="0"/>
        <joint name="r_joint3" value="0"/>
        <joint name="r_joint4" value="0"/>
        <joint name="r_joint5" value="0"/>
        <joint name="r_joint6" value="0"/>
    </group_state>
    <group_state name="up" group="platform">
        <joint name="platform_joint" value="1"/>
    </group_state>
    <group_state name="down" group="platform">
        <joint name="platform_joint" value="0"/>
    </group_state>

    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link_underpan"/>

    <!-- ==================================================== -->
    <!-- 4C2 GRIPPER CONFIGURATION                            -->
    <!-- ==================================================== -->
    <xacro:if value="${'$(arg gripper_type)' == '4c2'}">
        <group name="left_gripper">
            <link name="l_4c2_base_link"/>
            <link name="l_r_1"/>
            <link name="l_r_3"/>
            <link name="l_l_1"/>
            <link name="l_l_3"/>
            <link name="l_l_2_base"/>
            <link name="l_l_2"/>
            <link name="l_r_2_base"/>
            <link name="l_r_2"/>
        </group>
        <group name="right_gripper">
            <link name="r_4c2_base_link"/>
            <link name="r_r_1"/>
            <link name="r_r_3"/>
            <link name="r_l_1"/>
            <link name="r_l_3"/>
            <link name="r_l_2_base"/>
            <link name="r_l_2"/>
            <link name="r_r_2_base"/>
            <link name="r_r_2"/>
        </group>
        <end_effector name="left_gripper" parent_link="l_link6" group="left_gripper" parent_group="left_arm"/>
        <end_effector name="right_gripper" parent_link="r_link6" group="right_gripper" parent_group="right_arm"/>

        <!-- 4c2 Specific Collisions -->
        <disable_collisions link1="camera_link" link2="r_r_2_base" reason="Never"/>
        <disable_collisions link1="head_link1" link2="l_r_2" reason="Never"/>
        <disable_collisions link1="head_link1" link2="l_r_2_base" reason="Never"/>
        <disable_collisions link1="head_link1" link2="r_l_2_base" reason="Never"/>
        
        <disable_collisions link1="l_4c2_base_link" link2="l_l_1" reason="Adjacent"/>
        <disable_collisions link1="l_4c2_base_link" link2="l_l_2" reason="Never"/>
        <disable_collisions link1="l_4c2_base_link" link2="l_l_2_base" reason="Adjacent"/>
        <disable_collisions link1="l_4c2_base_link" link2="l_l_3" reason="Never"/>
        <disable_collisions link1="l_4c2_base_link" link2="l_link3" reason="Never"/>
        <disable_collisions link1="l_4c2_base_link" link2="l_link4" reason="Never"/>
        <disable_collisions link1="l_4c2_base_link" link2="l_link5" reason="Default"/>
        <disable_collisions link1="l_4c2_base_link" link2="l_link6" reason="Adjacent"/>
        <disable_collisions link1="l_4c2_base_link" link2="l_r_1" reason="Adjacent"/>
        <disable_collisions link1="l_4c2_base_link" link2="l_r_2" reason="Never"/>
        <disable_collisions link1="l_4c2_base_link" link2="l_r_2_base" reason="Adjacent"/>
        <disable_collisions link1="l_4c2_base_link" link2="l_r_3" reason="Never"/>
        <disable_collisions link1="l_4c2_base_link" link2="link_right_wheel" reason="Never"/>
        <disable_collisions link1="l_4c2_base_link" link2="link_swivel_wheel_1_1" reason="Never"/>
        <disable_collisions link1="l_4c2_base_link" link2="link_swivel_wheel_1_2" reason="Never"/>
        <disable_collisions link1="l_4c2_base_link" link2="link_swivel_wheel_2_1" reason="Never"/>
        <disable_collisions link1="l_4c2_base_link" link2="link_swivel_wheel_2_2" reason="Never"/>
        <disable_collisions link1="l_4c2_base_link" link2="link_swivel_wheel_3_1" reason="Never"/>
